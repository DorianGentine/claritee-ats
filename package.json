{
  "name": "claritee-ats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/check-local-services.sh",
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run test:unit && bun run test:db",
    "test:unit": "vitest run __tests__/unit",
    "test:db": "bash scripts/test-db.sh",
    "test:watch": "vitest __tests__/unit",
    "a11y": "pa11y --standard WCAG2AA http://localhost:3000/dashboard http://localhost:3000/settings/team",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:reset": "supabase db reset --no-seed && prisma migrate deploy",
    "db:pull:prod": "bash scripts/db-pull-prod.sh",
    "storage:orphans": "tsx scripts/storage-orphans.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.3",
    "@tanstack/react-query": "5.90.21",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@trpc/client": "11.10.0",
    "@trpc/next": "11.10.0",
    "@trpc/react-query": "11.10.0",
    "@trpc/server": "11.10.0",
    "@vercel/speed-insights": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "17.3.1",
    "lucide-react": "0.564.0",
    "next": "16.1.6",
    "pg": "8.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "sonner": "1.7.4",
    "tailwind-merge": "3.4.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "25.0.1",
    "pa11y": "9.1.0",
    "prettier": "3.8.1",
    "prisma": "7.4.0",
    "shadcn": "3.8.4",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "vitest": "4.0.18",
    "vitest-axe": "0.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "bun@1.4.1"
}
