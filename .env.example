# Claritee ATS - Variables d'environnement
# Copier vers .env.local et renseigner les valeurs

# Database (Supabase PostgreSQL)
# Valeurs par défaut : base LOCALE (bun run db:local:start). Ne jamais mettre les URL de prod
# dans .env.local : prisma.config.ts le charge, les migrations partiraient sur la prod.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#
# Prod (variables Vercel et .env.prod.local uniquement) :
#   DATABASE_URL        = pooler "Transaction" : postgresql://postgres.[ref]:[password]@aws-…-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_DATABASE_URL = pooler "Session" (migrations, dont le build Vercel) : même URL, port 5432, sans ?pgbouncer=true
#   Pas la connexion directe db.[ref].supabase.co : IPv6 uniquement, injoignable depuis Vercel.

# Supabase - URL du projet
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"

# Supabase - Clé publique (client-side, ex. sb_publishable_xxx)
# Dashboard : API Keys > Publishable key (anciennement "anon key")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase - Clé secrète (serveur uniquement, jamais exposer au client)
# Dashboard : API Keys > Secret key (anciennement "service_role key")
SUPABASE_SECRET_KEY=""

# Keep-alive - secret partagé protégeant /api/keep-alive (optionnel en local).
# En prod : définir la même valeur sur Vercel ET dans le secret GitHub Actions
# KEEPALIVE_SECRET (voir .github/workflows/keep-alive.yml).
KEEPALIVE_SECRET=""

# Import LinkedIn via Apify (optionnel) - sans jeton, l'import est masqué.
# Jeton : console.apify.com → Settings → API & Integrations.
APIFY_TOKEN=""
# Acteur utilisé, parmi ceux gérés dans src/server/linkedin/apify.ts :
# supreme_coder~linkedin-profile-scraper (défaut) ou harvestapi~linkedin-profile-scraper
# (secours ; plafonné à 50 runs au total sur un compte Apify gratuit).
# APIFY_LINKEDIN_ACTOR=""
